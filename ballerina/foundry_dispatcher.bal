import ballerina/http;
import ballerina/http.httpscerr;
import ballerina/jballerina.java;
import ballerina/log;
import ballerina/uuid;

// The response headers the Foundry listener sets on every response (`core/_base.py:662-693`,
// `core/_request_id.py:51-120`).
const HEADER_PLATFORM_SERVER = "x-platform-server";
const HEADER_REQUEST_ID = "x-request-id";
const HEADER_TRACEPARENT = "traceparent";
const ZERO_TRACE_ID = "00000000000000000000000000000000";
// The `http:RequestContext` key under which the request interceptor stores the resolved request ID.
const REQUEST_ID_CONTEXT_KEY = "ballerinax.ai.azure.foundry.requestId";

const READINESS_PATH = "readiness";
// The readiness body, byte-for-byte as the reference sends it (`core/_base.py:46`).
const READINESS_BODY = "{\"status\":\"healthy\"}";
const APPLICATION_JSON = "application/json";

// Error codes of the error envelope (`core/_errors.py`, `inv/_invocation.py`).
const ERROR_CODE_NOT_FOUND = "not_found";
const ERROR_CODE_METHOD_NOT_ALLOWED = "method_not_allowed";
const ERROR_CODE_INVALID_REQUEST = "invalid_request";
const ERROR_CODE_NOT_IMPLEMENTED = "not_implemented";
const ERROR_CODE_INTERNAL_ERROR = "internal_error";

// Headers of an error that are not copied onto the error response, because they describe the error's
// own body or connection, not the error-envelope response.
final readonly & string[] NON_COPIED_ERROR_HEADERS = ["content-type", "content-length", "content-encoding",
    "transfer-encoding", "connection", "keep-alive"];

# The `x-platform-server` header value, `ballerinax-ai.azure/<package version> (ballerina/<runtime version>)`.
# The package version is generated by the build from the project version, so it can't drift from
# `Ballerina.toml`.
final string FOUNDRY_SERVER_VERSION = foundryServerVersion();

# What the dispatcher needs from the listener configuration, kept as read-only data so the
# dispatcher stays isolated.
#
# + agent - Information about the hosted agent
# + sseKeepAliveInterval - Seconds of inactivity on a server-sent event stream before a keep-alive
# comment is sent; `0` disables keep-alive comments
# + openApiSpec - The OpenAPI document served at `GET /invocations/docs/openapi.json`, if any
type FoundryDispatcherConfig record {|
    FoundryAgentInfo agent;
    int sseKeepAliveInterval;
    map<json>? openApiSpec;
|};

# Internal service that `FoundryListener` attaches to the `http:Listener` in place of the user's
# `FoundryInvocationService`.
#
# It serves the platform routes and, through its interceptors, sets `x-platform-server` and
# `x-request-id` on every response it produces, including the error responses the http module
# generates itself (for example a payload-binding failure). The interceptors are service-level, so
# they also apply when the dispatcher shares a user-provided `http:Listener` with other services,
# and they don't affect those services.
#
# The dispatcher holds no Ballerina mutable state: the user's service is linked with it as native
# data by `FoundryListener.attach` (before the dispatcher is attached, so it never serves a request
# without the link), so requests are served concurrently.
#
# Protocol routes are added as specific resources; the catch-all `default` resource handles only the
# paths and methods no specific resource matches.
isolated service class FoundryDispatcherService {
    *http:InterceptableService;

    private final readonly & FoundryDispatcherConfig config;

    isolated function init(readonly & FoundryDispatcherConfig config) {
        self.config = config;
    }

    # Returns the interceptor pipeline of the dispatcher.
    #
    # + return - The request-ID interceptor, the response-header interceptor and the error interceptor.
    # The error interceptor comes last so it sees errors first; the response it builds then passes
    # through the response-header interceptor
    public isolated function createInterceptors() returns http:Interceptor[] => [
        new FoundryRequestIdInterceptor(),
        new FoundryResponseHeaderInterceptor(),
        new FoundryResponseErrorInterceptor()
    ];

    # `GET /readiness`: the readiness probe. It always reports healthy and calls no model.
    #
    # + return - `200` with `{"status":"healthy"}`
    isolated resource function get readiness() returns http:Response => readinessResponse();

    # Catch-all for every path and method that no other resource serves.
    #
    # The status codes and the `Allow` header match the reference (Starlette routing). The body is the
    # Foundry error envelope rather than Starlette's plain-text `Not Found` / `Method Not Allowed`, so
    # every error the listener produces has the same shape (a deliberate deviation).
    #
    # + path - The request path segments
    # + request - The request
    # + return - `405` for a known path with a method it doesn't allow, otherwise `404`, both with
    # the error envelope
    isolated resource function default [string... path](http:Request request) returns http:Response {
        string method = request.method.toUpperAscii();
        string[]? allowed = allowedMethods(path);
        if allowed is () {
            return errorResponse(http:STATUS_NOT_FOUND, ERROR_CODE_NOT_FOUND, "Not Found");
        }
        if method == http:HTTP_HEAD && allowed.indexOf(http:HTTP_HEAD) !is () {
            // HEAD on a GET route, as Starlette serves it: the GET response without a body.
            return headResponse(path);
        }
        http:Response response = errorResponse(http:STATUS_METHOD_NOT_ALLOWED, ERROR_CODE_METHOD_NOT_ALLOWED,
                "Method Not Allowed");
        response.setHeader("allow", string:'join(", ", ...allowed));
        return response;
    }

    # Returns the dispatcher configuration.
    #
    # + return - The read-only dispatcher configuration
    isolated function getConfig() returns readonly & FoundryDispatcherConfig => self.config;
}

# Returns the methods a known platform path allows, or `()` for an unknown path. Protocol routes are
# added here with their resources, so a wrong method on them gets `405` instead of `404`.
#
# + path - The request path segments
# + return - The allowed methods, or `()` when the path is unknown
isolated function allowedMethods(string[] path) returns string[]? {
    if path == [READINESS_PATH] {
        return [http:HTTP_GET, http:HTTP_HEAD];
    }
    return ();
}

# Builds the response to a `HEAD` request on a known `GET` path.
#
# + path - The request path segments
# + return - The `GET` response's status and headers, without a body
isolated function headResponse(string[] path) returns http:Response {
    http:Response response = new;
    if path == [READINESS_PATH] {
        response.setHeader("content-type", APPLICATION_JSON);
    }
    return response;
}

# Builds the readiness response.
#
# + return - `200` with `{"status":"healthy"}` and content type application/json
isolated function readinessResponse() returns http:Response {
    http:Response response = new;
    response.setTextPayload(READINESS_BODY, APPLICATION_JSON);
    return response;
}

# Builds a response with the standard error envelope `{"error":{"code":...,"message":...}}`
# (`core/_errors.py`).
#
# + statusCode - The HTTP status code
# + code - The machine-readable error code
# + message - The human-readable error message
# + return - The error response
isolated function errorResponse(int statusCode, string code, string message) returns http:Response {
    http:Response response = new;
    response.statusCode = statusCode;
    response.setJsonPayload({'error: {code, message}});
    return response;
}

# Resolves the `x-request-id` of a request, in the reference's order (`core/_request_id.py:100-120`):
# 1. the trace ID of the incoming W3C `traceparent` header, when it is valid and not all zeros;
# 2. the incoming `x-request-id` header, when it is present and not empty;
# 3. a new UUID as 32 hex digits (`uuid.uuid4().hex`).
#
# The reference first asks OpenTelemetry for the active span's trace ID and parses `traceparent`
# only when no span is active (`core/_middleware.py:117-142`). No span is active at the point the
# reference resolves the request ID, so parsing `traceparent` is the step that runs there.
#
# + request - The request
# + return - The request ID
isolated function resolveRequestId(http:Request request) returns string {
    string|http:HeaderNotFoundError traceparent = request.getHeader(HEADER_TRACEPARENT);
    if traceparent is string {
        string? traceId = traceIdFromTraceparent(traceparent);
        if traceId is string {
            return traceId;
        }
    }
    string|http:HeaderNotFoundError incoming = request.getHeader(HEADER_REQUEST_ID);
    return incoming is string && incoming != "" ? incoming : newRequestId();
}

# Extracts the trace-id field of a W3C `traceparent` header value,
# `<version>-<trace-id>-<parent-id>-<flags>` (`_parse_trace_id_from_traceparent`,
# `core/_middleware.py:97-114`).
#
# + traceparent - The raw header value
# + return - The trace ID, or `()` when the value has fewer than four fields, the trace ID is not 32
# characters long or it is all zeros
isolated function traceIdFromTraceparent(string traceparent) returns string? {
    string[] parts = re `-`.split(traceparent.trim());
    if parts.length() >= 4 && parts[1].length() == 32 && parts[1] != ZERO_TRACE_ID {
        return parts[1];
    }
    return ();
}

# Generates a request ID: a version 4 UUID as 32 lower-case hex digits.
#
# + return - The request ID
isolated function newRequestId() returns string => re `-`.replaceAll(uuid:createType4AsString(), "");

# Sets the platform response headers on a response.
#
# + response - The response
# + requestId - The resolved request ID
isolated function setPlatformHeaders(http:Response response, string requestId) {
    response.setHeader(HEADER_PLATFORM_SERVER, FOUNDRY_SERVER_VERSION);
    response.setHeader(HEADER_REQUEST_ID, requestId);
}

# Reads the request ID that `FoundryRequestIdInterceptor` stored in the request context.
#
# + ctx - The request context
# + return - The stored request ID, or `()` when none is stored
isolated function requestIdFromContext(http:RequestContext ctx) returns string? {
    if !ctx.hasKey(REQUEST_ID_CONTEXT_KEY) {
        return ();
    }
    http:ReqCtxMember value = ctx.get(REQUEST_ID_CONTEXT_KEY);
    return value is string ? value : ();
}

# Resolves the request ID once per request and stores it in the request context, so the response
# interceptors set the same value on the response.
isolated service class FoundryRequestIdInterceptor {
    *http:RequestInterceptor;

    isolated resource function default [string... path](http:RequestContext ctx, http:Request request)
            returns http:NextService|error? {
        ctx.set(REQUEST_ID_CONTEXT_KEY, resolveRequestId(request));
        return ctx.next();
    }
}

# Sets `x-platform-server` and `x-request-id` on every response of the dispatcher, including the
# responses built by `FoundryResponseErrorInterceptor`.
isolated service class FoundryResponseHeaderInterceptor {
    *http:ResponseInterceptor;

    isolated remote function interceptResponse(http:RequestContext ctx, http:Response response)
            returns http:NextService|error? {
        setPlatformHeaders(response, requestIdFromContext(ctx) ?: newRequestId());
        return ctx.next();
    }
}

# Turns an error that reaches the http module (for example a payload-binding failure, or an error a
# resource returns) into a response with the Foundry error envelope, instead of leaving it to the
# listener's default error interceptor, whose response would skip the dispatcher's response
# interceptor and so lack the platform headers.
isolated service class FoundryResponseErrorInterceptor {
    *http:ResponseErrorInterceptor;

    isolated remote function interceptResponseError(error err, http:RequestContext ctx, http:Request request)
            returns http:Response {
        if requestIdFromContext(ctx) is () {
            // The error happened before the request interceptor ran.
            ctx.set(REQUEST_ID_CONTEXT_KEY, resolveRequestId(request));
        }
        return errorToResponse(err, request);
    }
}

# Maps an error to a response with the error envelope. The status code follows the http module's
# own mapping; a `4xx` keeps the error message (it describes the caller's mistake), while a `5xx`
# carries a generic message so internal details don't leak.
#
# + err - The error
# + request - The request
# + return - The error response
isolated function errorToResponse(error err, http:Request request) returns http:Response {
    int statusCode = statusCodeOf(err);
    http:Response response;
    if statusCode >= 500 {
        log:printError("unhandled error in the Foundry listener", err, path = request.rawPath,
                method = request.method);
        response = errorResponse(statusCode, statusCode == http:STATUS_NOT_IMPLEMENTED
            ? ERROR_CODE_NOT_IMPLEMENTED : ERROR_CODE_INTERNAL_ERROR, "Internal server error");
    } else {
        string code = statusCode == http:STATUS_NOT_FOUND ? ERROR_CODE_NOT_FOUND
            : statusCode == http:STATUS_METHOD_NOT_ALLOWED ? ERROR_CODE_METHOD_NOT_ALLOWED
                : ERROR_CODE_INVALID_REQUEST;
        response = errorResponse(statusCode, code, err.message());
    }
    // Keep the headers the error carries, as the http module's `getErrorResponse` does. An
    // `http:ApplicationResponseError` (an http:Client call that got a 4xx/5xx) carries the upstream
    // response's headers, for example `www-authenticate` or `retry-after`.
    if err is http:ApplicationResponseError {
        copyErrorHeaders(response, err.detail().headers);
    } else if err is httpscerr:StatusCodeError {
        map<string|string[]>? headers = err.detail()?.headers;
        if headers is map<string|string[]> {
            copyErrorHeaders(response, headers);
        }
    }
    return response;
}

# Copies the headers an error carries onto the error response. Headers that describe the body or
# the connection are skipped: the response has its own error-envelope body, so an upstream
# `content-length` or `content-type` would be wrong for it.
#
# + response - The error response
# + headers - The headers the error carries
isolated function copyErrorHeaders(http:Response response, map<string|string[]> headers) {
    foreach [string, string|string[]] [name, value] in headers.entries() {
        if NON_COPIED_ERROR_HEADERS.indexOf(name.toLowerAscii()) !is () {
            continue;
        }
        if value is string {
            response.setHeader(name, value);
        } else {
            foreach string item in value {
                response.addHeader(name, item);
            }
        }
    }
}

# Returns the HTTP status code the http module uses for an error (`getStatusCode` in
# http module), so an error keeps its status when the Foundry error interceptor handles it.
#
# + err - The error
# + return - The status code; `500` for an error that carries none
isolated function statusCodeOf(error err) returns int {
    if err is http:ApplicationResponseError {
        return err.detail().statusCode;
    }
    if err is httpscerr:'4XXStatusCodeError {
        return clientErrorStatusCodeOf(err);
    }
    if err is httpscerr:NotImplementedError {
        return 501;
    } else if err is httpscerr:BadGatewayError {
        return 502;
    } else if err is httpscerr:ServiceUnavailableError {
        return 503;
    } else if err is httpscerr:GatewayTimeoutError {
        return 504;
    } else if err is httpscerr:HTTPVersionNotSupportedError {
        return 505;
    } else if err is httpscerr:VariantAlsoNegotiatesError {
        return 506;
    } else if err is httpscerr:InsufficientStorageError {
        return 507;
    } else if err is httpscerr:LoopDetectedError {
        return 508;
    } else if err is httpscerr:NotExtendedError {
        return 510;
    } else if err is httpscerr:NetworkAuthenticationRequiredError {
        return 511;
    } else if err is httpscerr:DefaultStatusCodeError {
        int? statusCode = err.detail()?.statusCode;
        if statusCode is int {
            return statusCode;
        }
        // As http's `getStatusCode`: without a status code, the cause decides.
        error? cause = err.cause();
        if cause is error {
            return statusCodeOf(cause);
        }
    }
    return 500;
}

isolated function clientErrorStatusCodeOf(httpscerr:'4XXStatusCodeError err) returns int {
    if err is httpscerr:BadRequestError {
        return 400;
    } else if err is httpscerr:UnauthorizedError {
        return 401;
    } else if err is httpscerr:PaymentRequiredError {
        return 402;
    } else if err is httpscerr:ForbiddenError {
        return 403;
    } else if err is httpscerr:NotFoundError {
        return 404;
    } else if err is httpscerr:MethodNotAllowedError {
        return 405;
    } else if err is httpscerr:NotAcceptableError {
        return 406;
    } else if err is httpscerr:ProxyAuthenticationRequiredError {
        return 407;
    } else if err is httpscerr:RequestTimeoutError {
        return 408;
    } else if err is httpscerr:ConflictError {
        return 409;
    } else if err is httpscerr:GoneError {
        return 410;
    } else if err is httpscerr:LengthRequiredError {
        return 411;
    } else if err is httpscerr:PreconditionFailedError {
        return 412;
    } else if err is httpscerr:PayloadTooLargeError {
        return 413;
    } else if err is httpscerr:URITooLongError {
        return 414;
    } else if err is httpscerr:UnsupportedMediaTypeError {
        return 415;
    } else if err is httpscerr:RangeNotSatisfiableError {
        return 416;
    } else if err is httpscerr:ExpectationFailedError {
        return 417;
    } else if err is httpscerr:MisdirectedRequestError {
        return 421;
    } else if err is httpscerr:UnprocessableEntityError {
        return 422;
    } else if err is httpscerr:LockedError {
        return 423;
    } else if err is httpscerr:FailedDependencyError {
        return 424;
    } else if err is httpscerr:UpgradeRequiredError {
        return 426;
    } else if err is httpscerr:PreconditionRequiredError {
        return 428;
    } else if err is httpscerr:TooManyRequestsError {
        return 429;
    } else if err is httpscerr:RequestHeaderFieldsTooLargeError {
        return 431;
    } else if err is httpscerr:UnavailableDueToLegalReasonsError {
        return 451;
    }
    return 400;
}

isolated function foundryServerVersion() returns string = @java:Method {
    'class: "io.ballerina.lib.ai.azure.FoundryServerVersion",
    name: "getServerVersion"
} external;

isolated function setFoundryService(FoundryDispatcherService dispatcher, FoundryInvocationService foundryService)
        = @java:Method {
    'class: "io.ballerina.lib.ai.azure.NativeFoundryServiceAdaptor"
} external;

isolated function getFoundryService(FoundryDispatcherService dispatcher) returns FoundryInvocationService? =
@java:Method {
    'class: "io.ballerina.lib.ai.azure.NativeFoundryServiceAdaptor"
} external;

isolated function unlinkFoundryService(FoundryDispatcherService dispatcher) = @java:Method {
    'class: "io.ballerina.lib.ai.azure.NativeFoundryServiceAdaptor"
} external;

isolated function registerFoundryDispatcher(FoundryInvocationService foundryService, FoundryListener foundryListener,
        FoundryDispatcherService dispatcher) returns boolean = @java:Method {
    'class: "io.ballerina.lib.ai.azure.NativeFoundryServiceAdaptor",
    name: "registerDispatcher"
} external;

isolated function getFoundryDispatcher(FoundryInvocationService foundryService, FoundryListener foundryListener)
        returns FoundryDispatcherService? = @java:Method {
    'class: "io.ballerina.lib.ai.azure.NativeFoundryServiceAdaptor",
    name: "getDispatcher"
} external;

isolated function removeFoundryDispatcher(FoundryInvocationService foundryService, FoundryListener foundryListener)
        returns FoundryDispatcherService? = @java:Method {
    'class: "io.ballerina.lib.ai.azure.NativeFoundryServiceAdaptor",
    name: "removeDispatcher"
} external;
