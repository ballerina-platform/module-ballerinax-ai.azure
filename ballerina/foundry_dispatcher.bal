# Maps an error to a response with the error envelope. The status code follows the http module's
# own mapping; a `4xx` keeps the error message (it describes the caller's mistake), while a `5xx`
# carries a generic message so internal details don't leak.
#
# + err - The error
# + request - The request
# + return - The error response
isolated function errorToResponse(error err, http:Request request) returns http:Response {
    int statusCode = statusCodeOf(err);
    http:Response response;
    if statusCode >= 500 {
        log:printError("unhandled error in the Foundry listener", err, path = request.rawPath,
                method = request.method);
        response = errorResponse(statusCode, statusCode == http:STATUS_NOT_IMPLEMENTED
            ? ERROR_CODE_NOT_IMPLEMENTED : ERROR_CODE_INTERNAL_ERROR, "Internal server error");
    } else {
        string code = statusCode == http:STATUS_NOT_FOUND ? ERROR_CODE_NOT_FOUND
            : statusCode == http:STATUS_METHOD_NOT_ALLOWED ? ERROR_CODE_METHOD_NOT_ALLOWED
                : ERROR_CODE_INVALID_REQUEST;
        response = errorResponse(statusCode, code, err.message());
    }
    // Keep the headers the error carries, as the http module's `getErrorResponse` does. An
    // `http:ApplicationResponseError` (an http:Client call that got a 4xx/5xx) carries the upstream
    // response's headers, for example `www-authenticate` or `retry-after`.
    if err is http:ApplicationResponseError {
        copyErrorHeaders(response, err.detail().headers);
    } else if err is httpscerr:StatusCodeError {
        map<string|string[]>? headers = err.detail()?.headers;
        if headers is map<string|string[]> {
            copyErrorHeaders(response, headers);
        }
    }
    return response;
}

# Copies the headers an error carries onto the error response. Headers that describe the body or
# the connection are skipped: the response has its own error-envelope body, so an upstream
# `content-length` or `content-type` would be wrong for it.
#
# + response - The error response
# + headers - The headers the error carries
isolated function copyErrorHeaders(http:Response response, map<string|string[]> headers) {
    foreach [string, string|string[]] [name, value] in headers.entries() {
        if NON_COPIED_ERROR_HEADERS.indexOf(name.toLowerAscii()) !is () {
            continue;
        }
        if value is string {
            response.setHeader(name, value);
        } else {
            foreach string item in value {
                response.addHeader(name, item);
            }
        }
    }
}

# Returns the HTTP status code the http module uses for an error (`getStatusCode` in
# http module), so an error keeps its status when the Foundry error interceptor handles it.
#
# + err - The error
# + return - The status code; `500` for an error that carries none
isolated function statusCodeOf(error err) returns int {
    if err is http:ApplicationResponseError {
        return err.detail().statusCode;
    }
    if err is httpscerr:'4XXStatusCodeError {
        return clientErrorStatusCodeOf(err);
    }
    if err is httpscerr:NotImplementedError {
        return 501;
    } else if err is httpscerr:BadGatewayError {
        return 502;
    } else if err is httpscerr:ServiceUnavailableError {
        return 503;
    } else if err is httpscerr:GatewayTimeoutError {
        return 504;
    } else if err is httpscerr:HTTPVersionNotSupportedError {
        return 505;
    } else if err is httpscerr:VariantAlsoNegotiatesError {
        return 506;
    } else if err is httpscerr:InsufficientStorageError {
        return 507;
    } else if err is httpscerr:LoopDetectedError {
        return 508;
    } else if err is httpscerr:NotExtendedError {
        return 510;
    } else if err is httpscerr:NetworkAuthenticationRequiredError {
        return 511;
    } else if err is httpscerr:DefaultStatusCodeError {
        int? statusCode = err.detail()?.statusCode;
        if statusCode is int {
            return statusCode;
        }
        // As http's `getStatusCode`: without a status code, the cause decides.
        error? cause = err.cause();
        if cause is error {
            return statusCodeOf(cause);
        }
    }
    return 500;
}

isolated function clientErrorStatusCodeOf(httpscerr:'4XXStatusCodeError err) returns int {
    if err is httpscerr:BadRequestError {
        return 400;
    } else if err is httpscerr:UnauthorizedError {
        return 401;
    } else if err is httpscerr:PaymentRequiredError {
        return 402;
    } else if err is httpscerr:ForbiddenError {
        return 403;
    } else if err is httpscerr:NotFoundError {
        return 404;
    } else if err is httpscerr:MethodNotAllowedError {
        return 405;
    } else if err is httpscerr:NotAcceptableError {
        return 406;
    } else if err is httpscerr:ProxyAuthenticationRequiredError {
        return 407;
    } else if err is httpscerr:RequestTimeoutError {
        return 408;
    } else if err is httpscerr:ConflictError {
        return 409;
    } else if err is httpscerr:GoneError {
        return 410;
    } else if err is httpscerr:LengthRequiredError {
        return 411;
    } else if err is httpscerr:PreconditionFailedError {
        return 412;
    } else if err is httpscerr:PayloadTooLargeError {
        return 413;
    } else if err is httpscerr:URITooLongError {
        return 414;
    } else if err is httpscerr:UnsupportedMediaTypeError {
        return 415;
    } else if err is httpscerr:RangeNotSatisfiableError {
        return 416;
    } else if err is httpscerr:ExpectationFailedError {
        return 417;
    } else if err is httpscerr:MisdirectedRequestError {
        return 421;
    } else if err is httpscerr:UnprocessableEntityError {
        return 422;
    } else if err is httpscerr:LockedError {
        return 423;
    } else if err is httpscerr:FailedDependencyError {
        return 424;
    } else if err is httpscerr:UpgradeRequiredError {
        return 426;
    } else if err is httpscerr:PreconditionRequiredError {
        return 428;
    } else if err is httpscerr:TooManyRequestsError {
        return 429;
    } else if err is httpscerr:RequestHeaderFieldsTooLargeError {
        return 431;
    } else if err is httpscerr:UnavailableDueToLegalReasonsError {
        return 451;
    }
    return 400;
}

